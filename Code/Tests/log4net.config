<log4net>
	<appender name="FileAppender" type="log4net.Appender.FileAppender">
		<file value="events.log" />
		<appendToFile value="true" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%date{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger.%method - %message%newline" />
		</layout>
	</appender>

	<appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="FATAL ERROR: %date{yyyy-MM-dd HH:mm:ss} [%thread] %logger.%method - %message%newline" />
		</layout>
		<filter type="log4net.Filter.LevelRangeFilter">
			<levelMin value="FATAL" />
			<levelMax value="FATAL" />
		</filter>
	</appender>

	<root>
		<level value="DEBUG" />
		<appender-ref ref="FileAppender" />
		<appender-ref ref="ConsoleAppender" />
	</root>
</log4net>